<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElwMeteo.Desktop"
             x:Class="ElwMeteo.Desktop.Views.SettingsView"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer Padding="18">
        <Grid ColumnDefinitions="*,*" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel Grid.Column="0" Margin="0,0,18,0">

                <TextBlock Text="POSITIONSQUELLE" Classes="section" />
                <ComboBox ItemsSource="{Binding LocationModes}" SelectedItem="{Binding LocationMode}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Classes="label" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="Automatisch versucht GPS, dann die IP-Ortung, zuletzt den hinterlegten Standort." />

                <TextBlock Text="MANUELLE POSITION" Classes="section" Margin="0,16,0,6" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BREITE" Classes="label" />
                        <TextBox Text="{Binding ManualLatitude}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LÄNGE" Classes="label" />
                        <TextBox Text="{Binding ManualLongitude}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="GPS-Fix übernehmen" Command="{Binding UseGpsFixAsManualCommand}" />
                    <Button Content="Als Standort merken" Command="{Binding UseManualAsHomeCommand}" />
                </StackPanel>

                <!-- ======================================= system location -->
                <TextBlock Text="SYSTEM-STANDORTDIENST" Classes="section" Margin="0,16,0,6" />
                <CheckBox Content="Betriebssystem nach der Position fragen"
                          IsChecked="{Binding UseSystemLocation}"
                          IsEnabled="{Binding HasSystemLocation}" />
                <TextBlock Classes="label" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="Wird nur genutzt, wenn kein frischer GPS-Fix vorliegt — und dann noch vor der IP-Ortung. Die Genauigkeit schwankt stark: ein eingebauter GNSS-Chip liefert Meter, WLAN-Umfeld einige Zehnermeter, ohne beides fällt das System auf die IP-Adresse zurück. Der angezeigte Radius sagt, welcher Fall vorliegt." />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="Jetzt abfragen" Command="{Binding TestSystemLocationCommand}"
                            IsEnabled="{Binding HasSystemLocation}" />
                    <Button Content="Als manuelle Position übernehmen"
                            Command="{Binding UseSystemLocationAsManualCommand}"
                            IsEnabled="{Binding HasSystemLocation}" />
                </StackPanel>
                <TextBlock Text="{Binding SystemLocationStatus}" Classes="body" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Text="ORTSSUCHE" Classes="section" Margin="0,16,0,6" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery}" Watermark="Ort, Straße, PLZ …" />
                    <Button Grid.Column="1" Content="Suchen" Command="{Binding SearchPlaceCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Margin="0,0,0,4"
                                    Command="{Binding $parent[UserControl].DataContext.UsePlaceCommand}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="12" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="STANDORT (FEUERWACHE)" Classes="section" Margin="0,16,0,6" />
                <TextBox Text="{Binding HomeName}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                    <TextBox Grid.Column="0" Text="{Binding HomeLatitude}" />
                    <TextBox Grid.Column="1" Text="{Binding HomeLongitude}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1">

                <TextBlock Text="GPS-EMPFÄNGER (NMEA)" Classes="section" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding GpsPortName}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Suchen" Command="{Binding RefreshPortsCommand}" />
                </Grid>
                <TextBlock Classes="label" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="Unter Windows COM3 und ähnlich, unter Linux /dev/ttyUSB0, unter macOS /dev/tty.usbserial…" />
                <TextBlock Text="BAUDRATE" Classes="label" Margin="0,9,0,3" />
                <TextBox Text="{Binding GpsBaudRate}" />
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button Content="Verbinden" Command="{Binding ConnectGpsCommand}" />
                    <Button Content="Trennen" Command="{Binding DisconnectGpsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding GpsStatus}" Classes="body" TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Text="ABRUFINTERVALL UND PROTOKOLL" Classes="section" Margin="0,16,0,6" />
                <TextBlock Text="INTERVALL IN SEKUNDEN" Classes="label" Margin="0,0,0,3" />
                <TextBox Text="{Binding WeatherRefreshSeconds}" />
                <TextBlock Text="BILDDAUER RADAR (MS)" Classes="label" Margin="0,9,0,3" />
                <TextBox Text="{Binding RadarFrameDelayMs}" />
                <CheckBox Content="Messwerte als CSV protokollieren" IsChecked="{Binding CsvLoggingEnabled}" Margin="0,8,0,0" />
                <Button Content="Protokollordner öffnen" Command="{Binding OpenCsvDirectoryCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,6,0,0" />

                <TextBlock Text="GEFAHRENBEREICH" Classes="section" Margin="0,16,0,6" />
                <TextBlock Text="INNENRADIUS IN METERN" Classes="label" Margin="0,0,0,3" />
                <TextBox Text="{Binding HazardInnerRadiusMetres}" />

                <TextBlock Text="OPENWEATHERMAP-SCHLÜSSEL" Classes="section" Margin="0,16,0,6" />
                <TextBox Text="{Binding OpenWeatherMapApiKey}" />
                <TextBlock Classes="label" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="Nur für die optionale OpenWeatherMap-Radarquelle. Alle anderen Dienste brauchen keinen Schlüssel." />

                <!-- ============================================== warnings -->
                <TextBlock Text="WARNMELDUNGEN" Classes="section" Margin="0,16,0,6" />
                <CheckBox Content="Bei neuer Warnung Signal geben"
                          IsChecked="{Binding WarningAlertEnabled}" />
                <TextBlock Classes="label" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="Ton und Banner, aber nur wenn eine Warnung neu dazukommt oder sich verschärft — nicht bei jedem Abruf." />

                <TextBlock Text="AB WELCHER STUFE" Classes="label" Margin="0,9,0,3" />
                <ComboBox ItemsSource="{Binding AlertLevels}" SelectedItem="{Binding AlertMinimumLevel}"
                          HorizontalAlignment="Stretch" />

                <CheckBox Content="Bevölkerungsschutz-Warnungen über NINA einbeziehen"
                          IsChecked="{Binding NinaEnabled}" Margin="0,12,0,0" />
                <TextBlock Classes="label" FontWeight="Normal" TextWrapping="Wrap" Margin="0,5,0,0"
                           Text="MoWaS, KATWARN, BIWAPP und Hochwasser vom Bundesamt für Bevölkerungsschutz — also Gefahrstoff, Kampfmittel, Trinkwasser, Evakuierung. DWD-Wetterwarnungen kommen weiter aus der genaueren eigenen Quelle." />

                <TextBlock Text="LANDKREIS ODER KREISFREIE STADT" Classes="label" Margin="0,9,0,3" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0" Text="{Binding NinaQuery}" Watermark="Kreis suchen …" />
                    <Button Grid.Column="1" Content="Suchen" Command="{Binding SearchNinaRegionCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding NinaResults}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                    Command="{Binding $parent[UserControl].DataContext.UseNinaRegionCommand}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="label mono" FontWeight="Normal" Margin="0,5,0,0"
                           Text="{Binding NinaRegionName}"
                           IsVisible="{Binding NinaRegionName, Converter={x:Static local:Converters.StringNotEmpty}}" />

                <CheckBox Content="Immer im Vordergrund" IsChecked="{Binding AlwaysOnTop}" Margin="0,16,0,0" />

                <Button Content="Übernehmen" Command="{Binding ApplyCommand}"
                        HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="14,9" />
                <TextBlock Text="{Binding StatusMessage}" Classes="body accent" TextWrapping="Wrap" Margin="0,8,0,0"
                           IsVisible="{Binding StatusMessage, Converter={x:Static local:Converters.StringNotEmpty}}" />

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16" />

                <!-- ============================================ aktualisierung -->
                <StackPanel DataContext="{Binding $parent[Window].DataContext.Update}">
                    <TextBlock Text="PROGRAMM-AKTUALISIERUNG" Classes="section" />

                    <TextBlock Text="{Binding CurrentVersionLabel}" Classes="body" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PlatformLabel}" Classes="label" FontWeight="Normal" />

                    <CheckBox Content="Täglich nach einer neuen Freigabe sehen"
                              IsChecked="{Binding UpdateCheckEnabled}" Margin="0,10,0,0" />
                    <CheckBox Content="Auch Vorabversionen anbieten"
                              IsChecked="{Binding IncludePreReleases}" />

                    <TextBlock Classes="label" FontWeight="Normal" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Geprüft wird nur — heruntergeladen und eingespielt wird nichts ohne Klick. Eine Anwendung, die sich im Einsatz selbst neu startet, ist schlimmer als eine veraltete." />

                    <TextBlock Text="REPOSITORY" Classes="label" Margin="0,12,0,3" />
                    <TextBox Text="{Binding Repository}" Classes="mono" FontSize="11" />

                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,12,0,0">
                        <Button Content="Jetzt prüfen"
                                Command="{Binding CheckCommand}"
                                IsEnabled="{Binding IsBusy, Converter={x:Static local:Converters.Not}}" />
                        <Button Content="Freigabeseite öffnen"
                                Command="{Binding OpenReleasePageCommand}"
                                IsVisible="{Binding ReleaseUrl, Converter={x:Static local:Converters.StringNotEmpty}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Classes="body" TextWrapping="Wrap" Margin="0,10,0,0" />

                    <!-- Schritt 2 und 3 erscheinen erst, wenn es etwas zu holen gibt. -->
                    <StackPanel IsVisible="{Binding IsUpdateAvailable}">
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,10" />

                        <TextBlock Text="{Binding ReleaseTitle}" Classes="body" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PackageLabel}" Classes="label" FontWeight="Normal" />
                        <TextBlock Text="{Binding IntegrityNote}" Classes="label" FontWeight="Normal"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />

                        <ScrollViewer MaxHeight="180" Margin="0,8,0,0">
                            <TextBlock Text="{Binding ReleaseNotes}" Classes="body muted"
                                       FontSize="11.5" TextWrapping="Wrap" />
                        </ScrollViewer>

                        <ProgressBar Height="4" Margin="0,10,0,0"
                                     Minimum="0" Maximum="1" Value="{Binding DownloadProgress}"
                                     IsVisible="{Binding IsBusy}" />

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                            <Button Content="Herunterladen und prüfen"
                                    Command="{Binding DownloadCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={x:Static local:Converters.Not}}" />
                            <Button Content="Diese Version überspringen"
                                    Command="{Binding SkipVersionCommand}" />
                        </StackPanel>

                        <!-- Der einzige Schritt, der die Installation anfasst. -->
                        <Border Background="#332ECC71" CornerRadius="4" Padding="11" Margin="0,12,0,0"
                                IsVisible="{Binding IsReadyToInstall}">
                            <StackPanel>
                                <TextBlock Classes="body" TextWrapping="Wrap"
                                           Text="Das Paket ist geladen, seine Prüfsumme stimmt und es ist vollständig entpackt. Beim Einspielen wird die Anwendung beendet, die alte Version daneben aufbewahrt und die neue gestartet." />
                                <Button Content="Einspielen und neu starten"
                                        Command="{Binding InstallAndRestartCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0" Padding="14,8" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
