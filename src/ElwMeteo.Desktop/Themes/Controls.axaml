<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Avalonia has no keyed Style applied via Style="{StaticResource}" the way
         WPF does; the equivalent is a class selector. The three text roles from
         the Windows head map onto .label, .body and .section. -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="TextBlock.warn">
        <Setter Property="Foreground" Value="{StaticResource CautionBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="Margin" Value="0,2" />
    </Style>

</Styles>
