<Application x:Class="ElwMeteo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElwMeteo.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:SeverityBrushConverter x:Key="SeverityBrush" />
            <local:SeverityGlyphConverter x:Key="SeverityGlyph" />
            <local:WarningLevelBrushConverter x:Key="WarningLevelBrush" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <local:NotConverter x:Key="Not" />
            <local:StringToVisibilityConverter x:Key="StringToVisibility" />
            <local:UiColourToBrushConverter x:Key="UiColourToBrush" />
            <local:LocationModeConverter x:Key="LocationModeLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
