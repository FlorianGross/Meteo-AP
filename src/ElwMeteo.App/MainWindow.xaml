<Window x:Class="ElwMeteo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ElwMeteo.App.Views"
        Title="ELW-Meteo"
        Height="920" Width="1500"
        MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Topmost="{Binding AlwaysOnTop}"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================ clock header ====== -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- local wall clock -->
                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Text="ORTSZEIT" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding Clock.LocalTime}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="38" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Clock.LocalDate}" Style="{StaticResource LabelText}" />
                        <TextBlock Text="  ·  " Style="{StaticResource LabelText}" />
                        <TextBlock Text="{Binding Clock.TimeZoneLabel}" Style="{StaticResource LabelText}" />
                    </StackPanel>
                </StackPanel>

                <!-- tactical date-time groups -->
                <StackPanel Grid.Column="1" Margin="0,0,32,0">
                    <TextBlock Text="TAKTISCHE ZEIT" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding Clock.TacticalLocal}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Style="{StaticResource LabelText}">
                        <Run Text="Zulu: " />
                        <Run Text="{Binding Clock.TacticalZulu, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                    </TextBlock>
                </StackPanel>

                <!-- UTC -->
                <StackPanel Grid.Column="2" Margin="0,0,32,0">
                    <TextBlock Text="UTC" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding Clock.UtcTime}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="30"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <!-- wind development, permanently visible because it moves the plume -->
                <StackPanel Grid.Column="3" MaxWidth="330">
                    <TextBlock Text="WINDENTWICKLUNG (6 H)" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding Dashboard.WindShiftHeadline}"
                               FontSize="17" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Dashboard.WindShiftBrush}" />
                    <TextBlock Text="{Binding Dashboard.WindShiftDetail}"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Dashboard.GustPeakLabel}"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- right-hand controls -->
                <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Alles aktualisieren"
                            Command="{Binding RefreshAllCommand}"
                            IsEnabled="{Binding Dashboard.IsBusy, Converter={StaticResource Not}}"
                            Padding="14,8" />
                    <CheckBox Content="Immer im Vordergrund"
                              IsChecked="{Binding AlwaysOnTop}"
                              FontSize="11" Margin="0,7,0,0"
                              HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== warning bar ===== -->
        <Border Grid.Row="1"
                Background="#33E63946"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,9"
                Visibility="{Binding Dashboard.HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Dashboard.WarningSummary}"
                       Style="{StaticResource BodyText}"
                       FontWeight="SemiBold" />
        </Border>

        <!-- ==================================================== tabs ====== -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Padding="0">
            <TabItem Header="Lage &amp; Wetter">
                <views:DashboardView DataContext="{Binding Dashboard}" />
            </TabItem>
            <TabItem Header="Karten &amp; Radar">
                <views:MapView DataContext="{Binding Map}" />
            </TabItem>
            <TabItem Header="Einstellungen">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>

        <!-- ============================================== status bar ====== -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding Dashboard.StatusMessage}"
                           Style="{StaticResource LabelText}"
                           FontWeight="Normal"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1"
                           Text="{Binding GpsIndicator}"
                           Style="{StaticResource LabelText}"
                           FontWeight="Normal"
                           Margin="16,0" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource LabelText}"
                           FontWeight="Normal"
                           Text="Quellen: Open-Meteo · Deutscher Wetterdienst · RainViewer · OpenStreetMap" />
            </Grid>
        </Border>
    </Grid>
</Window>
