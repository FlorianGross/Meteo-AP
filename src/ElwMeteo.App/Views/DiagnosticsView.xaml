<UserControl x:Class="ElwMeteo.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================== left column ====== -->
            <StackPanel Grid.Column="0">

                <!-- connectivity -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="VERBINDUNGSTEST" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Prüft jeden Dienst, den die Anwendung nutzt. Fällt alles aus, liegt es meist am Netz — Anmeldeportal im WLAN, Proxy oder kein Mobilfunk. Fallen einzelne aus, ist es der Anbieter oder eine Filterung."
                                   Margin="0,0,0,11" />

                        <Button Content="Verbindungstest starten"
                                Command="{Binding RunConnectivityCheckCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                HorizontalContentAlignment="Left" />

                        <TextBlock Text="{Binding ConnectivitySummary}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,11,0,0" />

                        <ItemsControl ItemsSource="{Binding Endpoints}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            CornerRadius="4"
                                            Padding="9,7"
                                            Margin="0,0,0,5">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource BodyText}"
                                                           FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Label}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Reachable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Text="{Binding Url}"
                                                       Style="{StaticResource Mono}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- DWD layer list -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DWD-LAYER LAUT SERVER" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="Die Layerliste, die der DWD-Server selbst ausgibt — die verbindliche Antwort auf die Frage, wie ein Layer wirklich heißt. Layer mit Zeitachse sind als solche markiert."
                                   Margin="0,0,0,11" />

                        <Button Content="Layerliste abrufen"
                                Command="{Binding LoadDwdLayersCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                HorizontalContentAlignment="Left" />

                        <TextBlock Text="{Binding DwdLayerSummary}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,11,0,8" />

                        <TextBox Text="{Binding DwdLayerFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filtert nach Layername und Titel, z. B. „radar“ oder „wind“."
                                 Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding DwdLayers}" MaxHeight="320">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource Mono}"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource LabelText}"
                                                       FontWeight="Normal" />
                                            <TextBlock Text="  ·  Zeitachse"
                                                       Style="{StaticResource LabelText}"
                                                       FontWeight="Normal"
                                                       Foreground="{StaticResource OkBrush}"
                                                       Visibility="{Binding IsAnimatable, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ========================================= right column ====== -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="VERBINDUNGSPROTOKOLL" Style="{StaticResource SectionHeader}" Margin="0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Kopieren"
                                        Command="{Binding CopyLogCommand}"
                                        Padding="9,4" FontSize="11" />
                                <Button Content="Leeren"
                                        Command="{Binding ClearLogCommand}"
                                        Padding="9,4" FontSize="11" Margin="5,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Summary}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />

                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="„Kopieren“ legt Protokoll, Verbindungstest und Layerliste als Text in die Zwischenablage — das ist genau das, was für eine Fehlermeldung gebraucht wird."
                                   Margin="0,0,0,11" />

                        <ItemsControl ItemsSource="{Binding Requests}" MaxHeight="560">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="3,0,0,0"
                                            CornerRadius="0,3,3,0"
                                            Padding="8,5"
                                            Margin="0,0,0,3"
                                            Background="{StaticResource PanelAltBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Timestamp, StringFormat=HH\\:mm\\:ss}"
                                                           Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Style="{StaticResource Mono}"
                                                           FontWeight="Bold"
                                                           Margin="9,0,0,0" />
                                                <TextBlock Text="{Binding DurationLabel}"
                                                           Style="{StaticResource Mono}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="9,0,0,0" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Url}"
                                                       Style="{StaticResource Mono}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       ToolTip="{Binding Url}"
                                                       Margin="0,2,0,0" />

                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource BodyText}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
