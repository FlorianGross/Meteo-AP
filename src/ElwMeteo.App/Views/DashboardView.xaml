<UserControl x:Class="ElwMeteo.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- A label/value pair, the workhorse of this whole tab. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" MinWidth="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="2*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <!-- ===================================== column 1: position + now -->
            <StackPanel Grid.Column="0">

                <!-- position -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="POSITION" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="{Binding PositionSource}"
                                       Style="{StaticResource LabelText}"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Grid>

                        <TextBlock Text="{Binding PositionDecimal}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding PositionNautical}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="{Binding AddressLine}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding AddressLine, Converter={StaticResource StringToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Button Content="Aktualisieren"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                            <Button Content="Position kopieren"
                                    Command="{Binding CopyPositionCommand}"
                                    Margin="7,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <TextBlock Text="Datenstand: " Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding LastUpdateLabel}" Style="{StaticResource LabelText}"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="  ·  " Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding DataAgeLabel}" Style="{StaticResource LabelText}" />
                        </StackPanel>

                        <Border Background="#33F59E0B" CornerRadius="4" Padding="8,5" Margin="0,8,0,0"
                                Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Daten älter als 20 Minuten — bitte aktualisieren."
                                       Style="{StaticResource BodyText}" FontSize="12"
                                       Foreground="{StaticResource CautionBrush}" />
                        </Border>

                        <Border Background="#33E63946" CornerRadius="4" Padding="8,5" Margin="0,8,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource BodyText}" FontSize="12"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- current conditions -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AKTUELLE MESSWERTE" Style="{StaticResource SectionHeader}" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding ConditionGlyph}"
                                       FontSize="46"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"
                                       Foreground="{StaticResource AccentBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Temperature}"
                                           FontSize="40" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding ConditionText}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding ApparentTemperature}" Style="{StaticResource LabelText}" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="LUFTFEUCHTE" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Humidity}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TAUPUNKT" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding DewPoint}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="LUFTDRUCK (NN)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Pressure}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="BEWÖLKUNG" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CloudCover}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="SICHTWEITE" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Visibility}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="NIEDERSCHLAG" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Precipitation}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="CAPE (GEWITTERENERGIE)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Cape}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="WOLKENBASIS (KONVEKTIV)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CloudBase}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- nowcast -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NIEDERSCHLAG — NÄCHSTE 3 STUNDEN (15-MIN-SCHRITTE)"
                                   Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding NowcastSummary}" Style="{StaticResource BodyText}" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding NowcastBars}" Height="86">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="1,0">
                                        <TextBlock Text="{Binding IntensityLabel}"
                                                   Style="{StaticResource ScaleLabel}"
                                                   HorizontalAlignment="Center" />
                                        <Rectangle Height="{Binding BarHeight}"
                                                   RadiusX="2" RadiusY="2"
                                                   Margin="0,2">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <!-- Highlight the quarter-hour we are in. -->
                                                        <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource CautionBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PrecipitationMm}" Value="0">
                                                            <Setter Property="Fill" Value="{StaticResource BorderBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <TextBlock Text="{Binding TimeLabel}"
                                                   Style="{StaticResource ScaleLabel}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Balkenwert in mm/h" Style="{StaticResource LabelText}"
                                   FontWeight="Normal" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- wind forecast -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WINDVORHERSAGE — NÄCHSTE 12 STUNDEN" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding WindShiftDetail}" Style="{StaticResource BodyText}" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding WindForecast}" Height="118">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" Margin="1,0"
                                                ToolTip="{Binding Compass}">
                                        <!-- Arrow shows where the air is heading in that hour. -->
                                        <Path Fill="{StaticResource MutedBrush}"
                                              Data="M 0,-7 L 4,2 L 1.4,2 L 1.4,7 L -1.4,7 L -1.4,2 L -4,2 Z"
                                              Width="16" Height="16"
                                              Stretch="None"
                                              HorizontalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="{Binding ArrowAngle}" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <TextBlock Text="{Binding GustLabel}"
                                                   Style="{StaticResource ScaleLabel}"
                                                   Foreground="{StaticResource CautionBrush}"
                                                   HorizontalAlignment="Center" />

                                        <!-- Gust bar sits behind the mean-wind bar. -->
                                        <Grid Height="50" VerticalAlignment="Bottom">
                                            <Rectangle Height="{Binding GustBarHeight}"
                                                       Fill="{StaticResource CautionBrush}"
                                                       Opacity="0.35"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom" />
                                            <Rectangle Height="{Binding SpeedBarHeight}"
                                                       Fill="{StaticResource AccentBrush}"
                                                       RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Bottom"
                                                       Margin="3,0" />
                                        </Grid>

                                        <TextBlock Text="{Binding SpeedLabel}"
                                                   Style="{StaticResource ScaleLabel}"
                                                   HorizontalAlignment="Center" />

                                        <TextBlock Text="{Binding TimeLabel}"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ScaleLabel}">
                                                    <Style.Triggers>
                                                        <!-- Mark the hour the wind turns. -->
                                                        <DataTrigger Binding="{Binding IsShiftPoint}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Balken: mittlerer Wind (blau) und Böen (orange) in km/h · Pfeil zeigt die Ausbreitungsrichtung"
                                   Style="{StaticResource LabelText}"
                                   FontWeight="Normal" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="{Binding GustPeakLabel}"
                                   Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource CautionBrush}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding GustPeakLabel, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================== column 2: wind + dispersion -->
            <StackPanel Grid.Column="2">

                <!-- wind -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WIND" Style="{StaticResource SectionHeader}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- compass rose with an arrow pointing downwind -->
                            <Grid Grid.Column="0" Width="112" Height="112" Margin="0,0,16,0">
                                <Ellipse Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource MutedBrush}" />

                                <TextBlock Text="N" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <TextBlock Text="S" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                <TextBlock Text="W" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Text="O" Style="{StaticResource LabelText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" />

                                <!--
                                    Arrow points the way the air travels, i.e. downwind.
                                    The geometry is symmetric about its own centre so that
                                    rotating around 0.5/0.5 pivots exactly on the tail axis.
                                -->
                                <Path Fill="{StaticResource CautionBrush}"
                                      Data="M 0,-30 L 8,-10 L 3,-10 L 3,30 L -3,30 L -3,-10 L -8,-10 Z"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding WindArrowAngle}" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WindSummary}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding WindDetail}" Style="{StaticResource BodyText}" />
                                <TextBlock Text="{Binding GustSummary}"
                                           Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CautionBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- dispersion -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AUSBREITUNG (GEFAHRSTOFF / RAUCH)" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="AUSBREITUNGSRICHTUNG" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding Downwind}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource CautionBrush}"
                                   Margin="0,0,0,11" />

                        <TextBlock Text="AUSBREITUNGSKLASSE (KLUG/MANIER · PASQUILL)" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding StabilityClass}" Style="{StaticResource FieldValue}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding StabilityLabel}" Style="{StaticResource LabelText}" Margin="0,0,0,8" />

                        <TextBlock Text="{Binding StabilityNote}"
                                   Style="{StaticResource BodyText}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,0,0,11" />

                        <TextBlock Text="RICHTWERT GEFAHRENBEREICH" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding HazardRange}" Style="{StaticResource FieldValue}" />

                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="4" Padding="9,7">
                            <TextBlock Style="{StaticResource BodyText}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="Orientierungshilfe für die Erstphase, kein Ausbreitungsmodell. Gelände, Bebauung, Quellstärke und Stoffeigenschaften sind nicht berücksichtigt." />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- crew load -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="BELASTUNG EINSATZKRÄFTE" Style="{StaticResource SectionHeader}" />

                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="WBGT (SCHATTEN)" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Wbgt}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="FEUCHTKUGEL" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding WetBulb}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ABSOLUTE FEUCHTE" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding AbsoluteHumidity}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="VEGETATIONSBRAND" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding FireRisk}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="{Binding FireRiskNote}"
                                   Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- daylight -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="TAGESLICHT &amp; MOND" Style="{StaticResource SectionHeader}" />

                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="SONNENAUFGANG" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Sunrise}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="SONNENUNTERGANG" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Sunset}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="BÜRGERLICHE DÄMMERUNG" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CivilTwilight}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TAGESLÄNGE" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding DayLength}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="SONNENSTAND" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding SolarPosition}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="MOND" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding Moon}" Style="{StaticResource FieldValue}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================= column 3: hints + warnings -->
            <StackPanel Grid.Column="4">

                <!-- operational hints -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="EINSATZHINWEISE" Style="{StaticResource SectionHeader}" />

                        <!-- Only shown while there is nothing to report. -->
                        <TextBlock Text="Keine wetterbedingten Besonderheiten."
                                   Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hints.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Hints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                            BorderThickness="3,0,0,0"
                                            CornerRadius="0,4,4,0"
                                            Padding="10,8"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Severity, Converter={StaticResource SeverityGlyph}}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Width="20"
                                                       VerticalAlignment="Top"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Topic}"
                                                           Style="{StaticResource LabelText}"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                                <TextBlock Text="{Binding Text}"
                                                           Style="{StaticResource BodyText}"
                                                           FontSize="12.5" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- DWD warnings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="AMTLICHE WARNUNGEN (DWD)" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding WarningSummary}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{Binding Level, Converter={StaticResource WarningLevelBrush}}"
                                            BorderThickness="4,0,0,0"
                                            CornerRadius="0,4,4,0"
                                            Padding="11,9"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}"
                                                       Style="{StaticResource BodyText}"
                                                       FontWeight="Bold" FontSize="13.5" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding LevelLabel}"
                                                           Style="{StaticResource LabelText}"
                                                           Foreground="{Binding Level, Converter={StaticResource WarningLevelBrush}}" />
                                                <TextBlock Text="  ·  " Style="{StaticResource LabelText}" />
                                                <TextBlock Text="{Binding TimeRangeLabel}" Style="{StaticResource LabelText}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RegionName}"
                                                       Style="{StaticResource LabelText}"
                                                       FontWeight="Normal" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource BodyText}"
                                                       FontSize="12" Margin="0,6,0,0"
                                                       Visibility="{Binding Description, Converter={StaticResource StringToVisibility}}" />
                                            <TextBlock Text="{Binding Instruction}"
                                                       Style="{StaticResource BodyText}"
                                                       FontSize="12" FontStyle="Italic"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,5,0,0"
                                                       Visibility="{Binding Instruction, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- documentation -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DOKUMENTATION" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Fertige Textblöcke für Einsatztagebuch und Funk. Jeder Abruf wird zusätzlich als CSV-Zeile protokolliert (siehe Einstellungen)."
                                   Margin="0,0,0,11" />

                        <Button Content="Wettermeldung für Einsatztagebuch kopieren"
                                Command="{Binding CopyLogEntryCommand}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,7" />
                        <Button Content="Kurzfassung für Funkspruch kopieren"
                                Command="{Binding CopyRadioLineCommand}"
                                HorizontalContentAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
