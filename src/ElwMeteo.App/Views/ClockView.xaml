<UserControl x:Class="ElwMeteo.App.Views.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <!--
        Readable from the other side of the vehicle: everything scales with the
        window through a Viewbox, so the clock fills whatever space it is given.
    -->
    <Viewbox Stretch="Uniform" Margin="40,28">
        <StackPanel HorizontalAlignment="Center">

            <!-- local wall clock -->
            <TextBlock Text="ORTSZEIT"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding Clock.LocalTime}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="190" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,-24,0,-30" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Text="{Binding Clock.LocalDate}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="30"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="  ·  "
                           FontFamily="{StaticResource UiFont}"
                           FontSize="30"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{Binding Clock.TimeZoneLabel}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="30"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <Border Height="2" Background="{StaticResource BorderBrush}" Margin="0,34,0,30" />

            <!-- tactical time and UTC side by side -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TAKTISCHE ZEIT"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Clock.TacticalLocal}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="96" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,-6,0,-10" />
                    <TextBlock FontFamily="{StaticResource UiFont}"
                               FontSize="22"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0">
                        <Run Text="Zulu " />
                        <Run Text="{Binding Clock.TacticalZulu, Mode=OneWay}"
                             FontFamily="{StaticResource MonoFont}"
                             Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="UTC"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Clock.UtcTime}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="96"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,-6,0,-10" />
                </StackPanel>
            </Grid>

            <Border Height="2" Background="{StaticResource BorderBrush}" Margin="0,34,0,26" />

            <!-- a short line of context, so the tab is not purely decorative -->
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,42,0">
                    <TextBlock Text="SONNENAUFGANG"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Dashboard.Sunrise}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="42"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>

                <StackPanel Margin="0,0,42,0">
                    <TextBlock Text="SONNENUNTERGANG"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Dashboard.Sunset}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="42"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>

                <StackPanel Margin="0,0,42,0">
                    <TextBlock Text="TEMPERATUR"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Dashboard.Temperature}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="42"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="WIND"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding Dashboard.WindSummary}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="42"
                               Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Viewbox>
</UserControl>
