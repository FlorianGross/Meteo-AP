<UserControl x:Class="ElwMeteo.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:cm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Groups the overlay checkboxes by topic (Warnungen, Niederschlag, ...). -->
        <CollectionViewSource x:Key="GroupedOverlays" Source="{Binding VisibleOverlays}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <CollectionViewSource x:Key="GroupedBaseLayers" Source="{Binding BaseLayers}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- A small accent bar makes the group headings scannable. -->
        <DataTemplate x:Key="GroupHeader">
            <StackPanel Orientation="Horizontal" Margin="0,11,0,5">
                <Rectangle Width="3" Height="11"
                           Fill="{StaticResource AccentBrush}"
                           RadiusX="1.5" RadiusY="1.5"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource LabelText}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="PickerList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- Selected base map reads as a filled card with an accent edge. -->
        <Style x:Key="PickerItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                CornerRadius="0,4,4,0"
                                Padding="9,6"
                                Margin="0,0,0,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PanelAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PanelAltBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =============================================== control panel ==== -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
                <StackPanel>

                    <!-- radar timeline -->
                    <TextBlock Text="REGENRADAR &amp; NOWCAST" Style="{StaticResource SectionHeader}" />

                    <CheckBox Content="Radar einblenden" IsChecked="{Binding ShowRadar}" />

                    <TextBlock Text="QUELLE" Style="{StaticResource LabelText}" Margin="0,10,0,3" />
                    <ComboBox ItemsSource="{Binding RadarSources}"
                              SelectedItem="{Binding SelectedRadarSource}"
                              DisplayMemberPath="Title" />
                    <TextBlock Text="{Binding SelectedRadarSource.Description}"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding RadarSourceNote}"
                               Style="{StaticResource BodyText}" FontSize="11.5"
                               Foreground="{StaticResource CautionBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding RadarSourceNote, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Text="{Binding FrameLabel}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,9,0,0" />

                    <TextBlock Text="{Binding RadarStatus}"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal"
                               Margin="0,2,0,8" />

                    <Slider Minimum="0"
                            Maximum="{Binding MaxFrameIndex}"
                            Value="{Binding FrameIndex}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="◀" Command="{Binding StepBackCommand}" Padding="11,5" MinWidth="38" />
                        <Button Content="▶ ⏸" Command="{Binding TogglePlayCommand}" Padding="11,5" Margin="5,0,0,0" MinWidth="52" />
                        <Button Content="▶" Command="{Binding StepForwardCommand}" Padding="11,5" Margin="5,0,0,0" MinWidth="38" />
                        <Button Content="Jetzt" Command="{Binding JumpToNowCommand}" Padding="11,5" Margin="5,0,0,0" />
                    </StackPanel>

                    <Button Content="Radar neu laden"
                            Command="{Binding RefreshRadarCommand}"
                            Margin="0,7,0,0"
                            HorizontalContentAlignment="Left" />

                    <TextBlock Text="RADAR-DECKKRAFT" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                    <Slider Minimum="0.15" Maximum="1.0" Value="{Binding RadarOpacity}" />

                    <TextBlock Text="FARBSCHEMA" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                    <ComboBox ItemsSource="{Binding ColourSchemes}"
                              SelectedItem="{Binding SelectedColourScheme}"
                              DisplayMemberPath="Title" />

                    <CheckBox Content="Schnee getrennt einfärben" IsChecked="{Binding ShowSnow}" Margin="0,8,0,0" />
                    <CheckBox Content="Kanten glätten" IsChecked="{Binding SmoothRadar}" />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,3">
                        <Run Text="RADAR NUR BIS ZOOMSTUFE " />
                        <Run Text="{Binding RadarMaxZoom, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="6" Maximum="16" Value="{Binding RadarMaxZoom}"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Style="{StaticResource LabelText}" FontWeight="Normal" TextWrapping="Wrap"
                               Margin="0,3,0,0"
                               Text="Radarkomposite haben rund einen Kilometer je Bildpunkt. Darüber hinaus wird nur hochskaliert — die Karte blendet das Radar dann aus und sagt es an." />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- satellite -->
                    <TextBlock Text="SATELLIT (INFRAROT)" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Wolkenbild einblenden" IsChecked="{Binding ShowSatellite}" />
                    <TextBlock Style="{StaticResource LabelText}" FontWeight="Normal" TextWrapping="Wrap"
                               Margin="0,4,0,6"
                               Text="Zeigt das Wolkenfeld auch nachts und außerhalb der Radarreichweite. Läuft synchron zur Radar-Zeitleiste." />
                    <Slider Minimum="0.15" Maximum="1.0" Value="{Binding SatelliteOpacity}" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- wind field -->
                    <TextBlock Text="WINDFELD" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Windpfeile im Umfeld anzeigen" IsChecked="{Binding ShowWindField}" />
                    <CheckBox Content="Windanimation (Strömungsbild)" IsChecked="{Binding ShowWindAnimation}" />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,10,0,3">
                        <Run Text="ANIMATION NUR BIS ZOOMSTUFE " />
                        <Run Text="{Binding WindAnimationMaxZoom, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="8" Maximum="17" Value="{Binding WindAnimationMaxZoom}"
                            TickFrequency="1" IsSnapToTickEnabled="True" />
                    <TextBlock Style="{StaticResource LabelText}" FontWeight="Normal" TextWrapping="Wrap"
                               Margin="0,3,0,8"
                               Text="Näher herangezoomt liegt der ganze Ausschnitt in einer Gitterzelle — dann tragen alle Partikel denselben Vektor. Die Dichte wird zusätzlich je Zoomstufe halbiert." />
                    <TextBlock Style="{StaticResource LabelText}" FontWeight="Normal" TextWrapping="Wrap"
                               Margin="0,4,0,8"
                               Text="Gitter aus Windvektoren rund um die Einsatzstelle. Weicht die Strömung im Umfeld deutlich ab, steuert das Gelände die Ausbreitung." />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,0,0,3">
                        <Run Text="GITTER: " />
                        <Run Text="{Binding WindFieldGridSize, Mode=OneWay}" />
                        <Run Text=" × " />
                        <Run Text="{Binding WindFieldGridSize, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="3" Maximum="9" Value="{Binding WindFieldGridSize}"
                            TickFrequency="2" IsSnapToTickEnabled="True" />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,10,0,3">
                        <Run Text="PUNKTABSTAND: " />
                        <Run Text="{Binding WindFieldSpacingMetres, StringFormat={}{0:F0} m, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="500" Maximum="10000" Value="{Binding WindFieldSpacingMetres}"
                            TickFrequency="500" IsSnapToTickEnabled="True" />

                    <Button Content="Windfeld laden"
                            Command="{Binding RefreshWindFieldCommand}"
                            IsEnabled="{Binding IsWindFieldLoading, Converter={StaticResource Not}}"
                            Margin="0,8,0,0"
                            HorizontalContentAlignment="Left" />

                    <TextBlock Text="{Binding WindFieldStatus}"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal" TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- base map -->
                    <TextBlock Text="GRUNDKARTE" Style="{StaticResource SectionHeader}" />
                    <ListBox ItemsSource="{Binding Source={StaticResource GroupedBaseLayers}}"
                             SelectedItem="{Binding SelectedBaseLayer}"
                             Style="{StaticResource PickerList}"
                             ItemContainerStyle="{StaticResource PickerItem}">
                        <ListBox.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeader}" />
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" FontSize="12.5" />
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource LabelText}"
                                               FontWeight="Normal"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- overlays -->
                    <TextBlock Text="OVERLAYS" Style="{StaticResource SectionHeader}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding LayerFilter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filtert nach Name, Gruppe und Beschreibung — z. B. „wind“, „brand“, „warn“." />
                        <Button Grid.Column="1" Content="✕"
                                Command="{Binding ResetLayerFilterCommand}"
                                Margin="5,0,0,0" Padding="9,5"
                                ToolTip="Filter zurücksetzen" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Alle Overlays aus"
                                Command="{Binding ClearOverlaysCommand}"
                                HorizontalContentAlignment="Left"
                                Padding="9,4" FontSize="11" />
                        <Button Content="DWD-Layer prüfen"
                                Command="{Binding CheckDwdLayersCommand}"
                                IsEnabled="{Binding IsCheckingCapabilities, Converter={StaticResource Not}}"
                                ToolTip="Fragt beim DWD-Server ab, welche Layer er tatsächlich anbietet."
                                Padding="9,4" FontSize="11" Margin="5,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding CapabilityStatus}"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal" TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedOverlays}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <StaticResource ResourceKey="GroupHeader" />
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Whole row is the hit target, not just the box. -->
                                <Border Style="{StaticResource OverlayRow}">
                                    <CheckBox IsChecked="{Binding IsEnabled}"
                                              ToolTip="{Binding Description}"
                                              VerticalContentAlignment="Top"
                                              Margin="0">
                                        <StackPanel Margin="3,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource LabelText}"
                                                       FontWeight="Normal"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding AvailabilityNote}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding AvailabilityNote, Converter={StaticResource StringToVisibility}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Style.Triggers>
                                                            <!-- A layer the server does not know is a real problem. -->
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- hazard cone -->
                    <TextBlock Text="AUSBREITUNGSKEGEL" Style="{StaticResource SectionHeader}" />

                    <CheckBox Content="Gefahrenbereich einzeichnen" IsChecked="{Binding ShowHazardCone}" />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,10,0,3">
                        <Run Text="REICHWEITE: " />
                        <Run Text="{Binding HazardRangeMetres, StringFormat={}{0:F0} m, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="0" Maximum="5000" Value="{Binding HazardRangeMetres}"
                            TickFrequency="250" IsSnapToTickEnabled="True" />
                    <TextBlock Text="0 m = Richtwert der Ausbreitungsklasse verwenden"
                               Style="{StaticResource LabelText}" FontWeight="Normal" Margin="0,3,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- view -->
                    <TextBlock Text="ANSICHT" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Karte auf Standort zentrieren" IsChecked="{Binding FollowPosition}" />
                    <Button Content="Jetzt zentrieren"
                            Command="{Binding RecentreOnPositionCommand}"
                            Margin="0,7,0,0"
                            HorizontalContentAlignment="Left" />

                    <!-- clicked point -->
                    <StackPanel Visibility="{Binding ClickedPositionLabel, Converter={StaticResource StringToVisibility}}">
                        <TextBlock Text="ANGEKLICKTER PUNKT" Style="{StaticResource LabelText}" Margin="0,14,0,3" />
                        <TextBlock Text="{Binding ClickedPositionLabel}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding ClickedWeatherLabel}"
                                   Style="{StaticResource BodyText}"
                                   FontSize="12"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,6,0,0" />
                        <Button Content="Punkt zurücksetzen"
                                Command="{Binding ClearClickedPointCommand}"
                                Margin="0,8,0,0"
                                Padding="9,4" FontSize="11"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================================================= map ==== -->
        <Grid Grid.Column="1">
            <wv2:WebView2 x:Name="MapWebView" DefaultBackgroundColor="#0E1116" />

            <!-- Shown until WebView2 reports itself ready, or if it is missing. -->
            <Border x:Name="MapOverlay"
                    Background="{StaticResource BackgroundBrush}"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                    <TextBlock x:Name="MapOverlayTitle"
                               Text="Karte wird geladen …"
                               FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="MapOverlayText"
                               Text="WebView2 wird initialisiert."
                               Style="{StaticResource BodyText}"
                               TextAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
