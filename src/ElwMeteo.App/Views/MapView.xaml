<UserControl x:Class="ElwMeteo.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:cm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Groups the overlay checkboxes by topic (Warnungen, Niederschlag, ...). -->
        <CollectionViewSource x:Key="GroupedOverlays" Source="{Binding Overlays}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =============================================== control panel ==== -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,14,10,14">
                <StackPanel>

                    <!-- radar timeline -->
                    <TextBlock Text="REGENRADAR &amp; NOWCAST" Style="{StaticResource SectionHeader}" />

                    <CheckBox Content="Radar einblenden" IsChecked="{Binding ShowRadar}" />

                    <TextBlock Text="{Binding FrameLabel}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,9,0,0" />

                    <TextBlock Text="{Binding RadarStatus}"
                               Style="{StaticResource LabelText}"
                               FontWeight="Normal"
                               Margin="0,2,0,8" />

                    <Slider Minimum="0"
                            Maximum="{Binding MaxFrameIndex}"
                            Value="{Binding FrameIndex}"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="◀" Command="{Binding StepBackCommand}" Padding="11,5" MinWidth="38" />
                        <Button Content="▶ ⏸" Command="{Binding TogglePlayCommand}" Padding="11,5" Margin="5,0,0,0" MinWidth="52" />
                        <Button Content="▶" Command="{Binding StepForwardCommand}" Padding="11,5" Margin="5,0,0,0" MinWidth="38" />
                        <Button Content="Jetzt" Command="{Binding JumpToNowCommand}" Padding="11,5" Margin="5,0,0,0" />
                    </StackPanel>

                    <Button Content="Radar neu laden"
                            Command="{Binding RefreshRadarCommand}"
                            Margin="0,7,0,0"
                            HorizontalContentAlignment="Left" />

                    <TextBlock Text="RADAR-DECKKRAFT" Style="{StaticResource LabelText}" Margin="0,12,0,3" />
                    <Slider Minimum="0.15" Maximum="1.0" Value="{Binding RadarOpacity}" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- base map -->
                    <TextBlock Text="GRUNDKARTE" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding BaseLayers}"
                              SelectedItem="{Binding SelectedBaseLayer}"
                              DisplayMemberPath="Title" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- overlays -->
                    <TextBlock Text="OVERLAYS" Style="{StaticResource SectionHeader}" />

                    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedOverlays}}">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" Margin="0,8,0,3" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled}"
                                          ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12.5" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- hazard cone -->
                    <TextBlock Text="AUSBREITUNGSKEGEL" Style="{StaticResource SectionHeader}" />

                    <CheckBox Content="Gefahrenbereich einzeichnen" IsChecked="{Binding ShowHazardCone}" />

                    <TextBlock Style="{StaticResource LabelText}" Margin="0,10,0,3">
                        <Run Text="REICHWEITE: " />
                        <Run Text="{Binding HazardRangeMetres, StringFormat={}{0:F0} m, Mode=OneWay}" />
                    </TextBlock>
                    <Slider Minimum="0" Maximum="5000" Value="{Binding HazardRangeMetres}"
                            TickFrequency="250" IsSnapToTickEnabled="True" />
                    <TextBlock Text="0 m = Richtwert der Ausbreitungsklasse verwenden"
                               Style="{StaticResource LabelText}" FontWeight="Normal" Margin="0,3,0,0" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />

                    <!-- view -->
                    <TextBlock Text="ANSICHT" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="Karte auf Standort zentrieren" IsChecked="{Binding FollowPosition}" />
                    <Button Content="Jetzt zentrieren"
                            Command="{Binding RecentreOnPositionCommand}"
                            Margin="0,7,0,0"
                            HorizontalContentAlignment="Left" />

                    <TextBlock Text="ANGEKLICKTER PUNKT" Style="{StaticResource LabelText}" Margin="0,14,0,3"
                               Visibility="{Binding ClickedPositionLabel, Converter={StaticResource StringToVisibility}}" />
                    <TextBlock Text="{Binding ClickedPositionLabel}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"
                               Visibility="{Binding ClickedPositionLabel, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================================================= map ==== -->
        <Grid Grid.Column="1">
            <wv2:WebView2 x:Name="MapWebView" DefaultBackgroundColor="#0E1116" />

            <!-- Shown until WebView2 reports itself ready, or if it is missing. -->
            <Border x:Name="MapOverlay"
                    Background="{StaticResource BackgroundBrush}"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                    <TextBlock x:Name="MapOverlayTitle"
                               Text="Karte wird geladen …"
                               FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="MapOverlayText"
                               Text="WebView2 wird initialisiert."
                               Style="{StaticResource BodyText}"
                               TextAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
