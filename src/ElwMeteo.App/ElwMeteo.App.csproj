<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>ElwMeteo.App</RootNamespace>
    <AssemblyName>ELW-Meteo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools/make-icon.py; the script is the source of truth. -->
    <ApplicationIcon>Assets\elw-meteo.ico</ApplicationIcon>
    <!-- The vehicle screen is usually scaled; let Windows hand us real pixels. -->
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElwMeteo.Core\ElwMeteo.Core.csproj" />
    <ProjectReference Include="..\ElwMeteo.Presentation\ElwMeteo.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Leaflet page is loaded into WebView2 from disk at runtime. -->
    <Content Include="Assets\map.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Embedded so the window and task bar can use it at runtime. -->
    <Resource Include="Assets\elw-meteo.ico" />
  </ItemGroup>

</Project>
